extends Node
## Autoload: all sounds are generated by code (original, no downloads, no
## import step). A worker thread builds the sounds after start-up so the menu
## appears instantly; sounds that are not ready yet are simply skipped.
## Two buses: "SFX" and "Music" with separate volumes (saved in user://audio.cfg).

const RATE := 22050
const SETTINGS_PATH := "user://audio.cfg"
const CHORDS := [
    {"root": 45, "tri": [57, 60, 64]},   # Am
    {"root": 41, "tri": [53, 57, 60]},   # F
    {"root": 48, "tri": [60, 64, 67]},   # C
    {"root": 43, "tri": [55, 59, 62]},   # G
]
const ARP := [0, 1, 2, 1, 0, 1, 2, 1]

var sfx_volume: float = 0.8
var music_volume: float = 0.5

var _streams: Dictionary = {}
var _pool: Array[AudioStreamPlayer] = []
var _music_player: AudioStreamPlayer
var _music_wanted: String = ""
var _music_playing: String = ""
var _thread: Thread
var _abort: bool = false
var _buf := PackedFloat32Array()
var _rng := RandomNumberGenerator.new()
var _prev: float = 0.0


func _ready() -> void:
    process_mode = Node.PROCESS_MODE_ALWAYS
    _rng.seed = 1234
    _load_settings()
    _ensure_bus(&"SFX")
    _ensure_bus(&"Music")
    _apply_volumes()
    for i in 8:
        var p := AudioStreamPlayer.new()
        p.bus = &"SFX"
        add_child(p)
        _pool.append(p)
    _music_player = AudioStreamPlayer.new()
    _music_player.bus = &"Music"
    add_child(_music_player)
    _thread = Thread.new()
    _thread.start(_generate_all)


func _exit_tree() -> void:
    _abort = true
    if _thread != null and _thread.is_started():
        _thread.wait_to_finish()


func _notification(what: int) -> void:
    # Silence the game when the app goes to the background.
    if what == NOTIFICATION_APPLICATION_PAUSED:
        AudioServer.set_bus_mute(0, true)
    elif what == NOTIFICATION_APPLICATION_RESUMED:
        AudioServer.set_bus_mute(0, false)


# ------------------------------------------------------------------ public

func get_stream(sound_name: String) -> AudioStream:
    return _streams.get(sound_name, null)


func play_sfx(sound_name: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
    var s: AudioStream = _streams.get(sound_name, null)
    if s == null:
        return
    var player: AudioStreamPlayer = _pool[0]
    for p in _pool:
        if not p.playing:
            player = p
            break
    player.stream = s
    player.volume_db = volume_db
    player.pitch_scale = pitch
    player.play()


func play_music(music_name: String) -> void:
    _music_wanted = music_name
    _start_music()


func stop_music() -> void:
    _music_wanted = ""
    _music_playing = ""
    _music_player.stop()


func set_sfx_volume(v: float) -> void:
    sfx_volume = clampf(v, 0.0, 1.0)
    _apply_volumes()
    _save_settings()


func set_music_volume(v: float) -> void:
    music_volume = clampf(v, 0.0, 1.0)
    _apply_volumes()
    _save_settings()


# ---------------------------------------------------------------- internals

func _ensure_bus(bus_name: StringName) -> void:
    if AudioServer.get_bus_index(bus_name) == -1:
        AudioServer.add_bus()
        var idx := AudioServer.bus_count - 1
        AudioServer.set_bus_name(idx, bus_name)
        AudioServer.set_bus_send(idx, &"Master")


func _apply_volumes() -> void:
    var s := AudioServer.get_bus_index(&"SFX")
    var m := AudioServer.get_bus_index(&"Music")
    AudioServer.set_bus_mute(s, sfx_volume <= 0.001)
    AudioServer.set_bus_volume_db(s, linear_to_db(maxf(sfx_volume, 0.001)))
    AudioServer.set_bus_mute(m, music_volume <= 0.001)
    AudioServer.set_bus_volume_db(m, linear_to_db(maxf(music_volume, 0.001)))


func _load_settings() -> void:
    var cfg := ConfigFile.new()
    if cfg.load(SETTINGS_PATH) == OK:
        sfx_volume = float(cfg.get_value("audio", "sfx", sfx_volume))
        music_volume = float(cfg.get_value("audio", "music", music_volume))


func _save_settings() -> void:
    var cfg := ConfigFile.new()
    cfg.set_value("audio", "sfx", sfx_volume)
    cfg.set_value("audio", "music", music_volume)
    cfg.save(SETTINGS_PATH)


func _start_music() -> void:
    if _music_wanted == "" or _music_playing == _music_wanted:
        return
    var s: AudioStream = _streams.get("music_" + _music_wanted, null)
    if s == null:
        return   # not generated yet; _store_stream starts it when ready
    _music_player.stream = s
    _music_player.play()
    _music_playing = _music_wanted


func _store_stream(sound_name: String, stream: AudioStream) -> void:
    _streams[sound_name] = stream
    if sound_name == "music_" + _music_wanted:
        _start_music()


# ------------------------------------------------- generation (worker thread)

func _generate_all() -> void:
    var jobs: Array[Array] = [
        ["engine", _gen_engine],
        ["screech", _gen_screech],
        ["nitro", _gen_nitro],
        ["rain", _gen_rain],
        ["crash", _gen_crash],
        ["shift", _gen_shift],
        ["beep", _gen_beep.bind(523.25, 0.22)],
        ["go", _gen_beep.bind(1046.5, 0.6)],
        ["win", _gen_win],
        ["lose", _gen_lose],
        ["music_menu", _gen_music.bind(false)],
        ["music_race", _gen_music.bind(true)],
    ]
    for job in jobs:
        if _abort:
            return
        var gen: Callable = job[1]
        var wav: AudioStreamWAV = gen.call()
        call_deferred("_store_stream", job[0], wav)


func _begin(n: int) -> void:
    _buf = PackedFloat32Array()
    _buf.resize(n)
    _prev = 0.0


func _finish(loop: bool, lowpass: float = 1.0) -> AudioStreamWAV:
    var n := _buf.size()
    var y := 0.0
    var peak := 0.0
    for i in n:
        if lowpass < 1.0:
            y += lowpass * (_buf[i] - y)
            _buf[i] = y
        peak = maxf(peak, absf(_buf[i]))
    var g := 1.0
    if peak > 0.95:
        g = 0.95 / peak
    var bytes := PackedByteArray()
    bytes.resize(n * 2)
    for i in n:
        bytes.encode_s16(i * 2, int(clampf(_buf[i] * g, -1.0, 1.0) * 32000.0))
    var w := AudioStreamWAV.new()
    w.format = AudioStreamWAV.FORMAT_16_BITS
    w.mix_rate = RATE
    w.stereo = false
    w.data = bytes
    if loop:
        w.loop_mode = AudioStreamWAV.LOOP_FORWARD
        w.loop_begin = 0
        w.loop_end = n
    return w


## wave: 0 sine, 1 saw, 2 square, 3 triangle
func _osc(t0: float, dur: float, freq: float, amp: float, decay: float, wave: int, attack: float = 0.01) -> void:
    var i0 := int(t0 * RATE)
    var count := int(dur * RATE)
    var inc := freq / float(RATE)
    var phase := 0.0
    var decay_mul := exp(-decay / float(RATE))
    var env := 1.0
    var att := maxf(attack * float(RATE), 1.0)
    var rel := float(maxi(1, mini(count, int(0.02 * RATE))))
    for k in count:
        var idx := i0 + k
        if idx >= _buf.size():
            break
        phase += inc
        if phase >= 1.0:
            phase -= 1.0
        var v: float
        if wave == 0:
            v = sin(TAU * phase)
        elif wave == 1:
            v = phase * 2.0 - 1.0
        elif wave == 2:
            v = 1.0 if phase < 0.5 else -1.0
        else:
            v = absf(phase * 4.0 - 2.0) - 1.0
        var a := minf(1.0, float(k) / att)
        var tail := minf(1.0, float(count - k) / rel)
        _buf[idx] += v * env * a * tail * amp
        env *= decay_mul


func _kick(t0: float) -> void:
    var i0 := int(t0 * RATE)
    for k in int(0.25 * RATE):
        var idx := i0 + k
        if idx >= _buf.size():
            break
        var t := float(k) / float(RATE)
        var ph := TAU * (45.0 * t + 3.0 * (1.0 - exp(-30.0 * t)))
        _buf[idx] += sin(ph) * exp(-t * 14.0) * 0.55


func _hat(t0: float) -> void:
    var i0 := int(t0 * RATE)
    var last := 0.0
    for k in int(0.06 * RATE):
        var idx := i0 + k
        if idx >= _buf.size():
            break
        var t := float(k) / float(RATE)
        var n := _rng.randf() * 2.0 - 1.0
        _buf[idx] += (n - last) * exp(-t * 70.0) * 0.10
        last = n


func _midi(m: int) -> float:
    return 440.0 * pow(2.0, (float(m) - 69.0) / 12.0)


func _gen_music(race: bool) -> AudioStreamWAV:
    var bpm := 132.0 if race else 96.0
    var step := 60.0 / bpm / 2.0     # one eighth note in seconds
    var steps := 32                   # 4 bars
    _begin(int(step * float(steps) * float(RATE)))
    for s in steps:
        var chord: Dictionary = CHORDS[(s >> 3) % 4]
        var tri: Array = chord["tri"]
        var root: int = chord["root"]
        var t0 := float(s) * step
        var note: int = tri[ARP[s % 8]] + (12 if ((s >> 3) % 2) == 1 else 0)
        if race:
            _osc(t0, step * 0.95, _midi(root), 0.30, 9.0, 1)
            _osc(t0, step * 0.9, _midi(note + 12), 0.16, 7.0, 1)
            if s % 2 == 0:
                _kick(t0)
            else:
                _hat(t0)
        else:
            if s % 8 == 0:
                for m in tri:
                    _osc(t0, step * 8.0, _midi(int(m)), 0.10, 0.5, 3, 0.25)
            if s % 4 == 0:
                _osc(t0, step * 3.6, _midi(root), 0.28, 1.5, 3)
            _osc(t0, step * 1.6, _midi(note + 12), 0.12, 4.0, 3)
    return _finish(true, 0.35 if race else 0.6)


func _gen_engine() -> AudioStreamWAV:
    _begin(RATE)
    var amps := PackedFloat32Array()
    for h in range(1, 9):
        amps.append(1.0 / pow(float(h), 0.85))
    for i in RATE:
        var t := float(i) / float(RATE)
        var x := 0.0
        for h in 8:
            x += sin(TAU * 56.0 * float(h + 1) * t + float(h) * 0.7) * amps[h]
        var pulse := 0.78 + 0.22 * sin(TAU * 28.0 * t)
        _buf[i] = tanh(x * 0.5 * pulse) * 0.75
    return _finish(true)


func _gen_screech() -> AudioStreamWAV:
    _begin(RATE)
    for i in RATE:
        var t := float(i) / float(RATE)
        var a := sin(TAU * 1700.0 * t + 5.0 * sin(TAU * 9.0 * t))
        var b := sin(TAU * 2300.0 * t + 3.0 * sin(TAU * 13.0 * t))
        var c := sin(TAU * 3100.0 * t + 2.0 * sin(TAU * 7.0 * t))
        var flutter := 0.8 + 0.2 * sin(TAU * 23.0 * t)
        _buf[i] = (a * 0.4 + b * 0.3 + c * 0.2) * flutter * 0.6
    return _finish(true)


func _gen_rain() -> AudioStreamWAV:
    _begin(RATE * 2)
    for i in RATE * 2:
        var drop := 1.0 if _rng.randf() < 0.0025 else 0.0
        _buf[i] = (_rng.randf() * 2.0 - 1.0) * 0.5 + drop * (_rng.randf() * 2.0 - 1.0) * 0.8
    return _finish(true, 0.45)


func _gen_nitro() -> AudioStreamWAV:
    _begin(RATE)
    var freqs := PackedFloat32Array()
    var phases := PackedFloat32Array()
    for j in 20:
        freqs.append(float(_rng.randi_range(180, 2600)))
        phases.append(_rng.randf() * TAU)
    for i in RATE:
        var t := float(i) / float(RATE)
        var x := 0.0
        for j in 20:
            x += sin(TAU * freqs[j] * t + phases[j])
        var mod := 0.85 + 0.15 * sin(TAU * 5.0 * t)
        _buf[i] = (x * 0.16 + sin(TAU * 47.0 * t) * 0.2) * mod
    return _finish(true)


func _gen_crash() -> AudioStreamWAV:
    _begin(int(RATE * 0.6))
    var lp := 0.0
    for i in _buf.size():
        var t := float(i) / float(RATE)
        lp += 0.3 * ((_rng.randf() * 2.0 - 1.0) - lp)
        _buf[i] = lp * 1.6 * exp(-t * 6.0) + sin(TAU * 58.0 * t) * exp(-t * 10.0) * 0.8
    return _finish(false)


func _gen_shift() -> AudioStreamWAV:
    _begin(int(RATE * 0.09))
    var lp := 0.0
    for i in _buf.size():
        var t := float(i) / float(RATE)
        lp += 0.4 * ((_rng.randf() * 2.0 - 1.0) - lp)
        _buf[i] = lp * exp(-t * 45.0) * 0.9 + sin(TAU * 140.0 * t) * exp(-t * 40.0) * 0.5
    return _finish(false)


func _gen_beep(freq: float, dur: float) -> AudioStreamWAV:
    _begin(int(RATE * dur))
    for i in _buf.size():
        var t := float(i) / float(RATE)
        var env := minf(1.0, t / 0.005) * minf(1.0, (dur - t) / 0.05)
        _buf[i] = (sin(TAU * freq * t) + 0.3 * sin(TAU * freq * 2.0 * t)) * env * 0.5
    return _finish(false)


func _gen_win() -> AudioStreamWAV:
    _begin(int(RATE * 1.5))
    var notes := [72, 76, 79, 84]
    for i in notes.size():
        _osc(float(i) * 0.14, 0.9 if i == 3 else 0.3, _midi(notes[i]), 0.3, 2.5, 0)
    return _finish(false)


func _gen_lose() -> AudioStreamWAV:
    _begin(int(RATE * 1.6))
    var notes := [67, 64, 60, 55]
    for i in notes.size():
        _osc(float(i) * 0.25, 0.9 if i == 3 else 0.4, _midi(notes[i]), 0.3, 2.0, 3)
    return _finish(false)
